# Multi-Gen LRU support (default set)
# Source (CloudFox kernel exp/mglru-backport mm/Kconfig):
#   https://github.com/CloudFox-INC/CloudFox-Kernel/blob/exp/mglru-backport/mm/Kconfig
#
# MGLRU is a high-performance LRU implementation that overcommits memory more
# efficiently than the classic single-gen LRU. The mglru-backport branch
# already sets CONFIG_LRU_GEN=y in its committed gki_defconfig; LRU_GEN_ENABLED
# selects the "Enable by default" choice so the new LRU actually takes effect
# without a boot-time parameter. LRU_GEN_STATS (full stats for debugging) is
# intentionally left at its default n: it adds per-memcg and per-node overhead.
#
# CONFIG_LRU_GEN depends on MMU (implied by the ARM64 build) and 64BIT, both of
# which hold for GKI. build-kernel.sh skips symbols already effective in the
# defconfig, so re-stating LRU_GEN here is idempotent.

CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
