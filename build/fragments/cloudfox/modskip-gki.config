# Skip loading kernel modules already built into the kernel
# Kernel (CloudFox ack-lts): CONFIG_MODULE_SKIP_BUILTIN, added in
#   "module: skip loading drivers already built into vmlinux"
# A compatibility shim so recovery/ramdisk loaders that unconditionally
# insmod .ko files for drivers already compiled into the kernel (e.g.
# zsmalloc.ko, zram.ko) no longer fail module init with EBUSY/EEXIST.
# The set of built-in module names is derived from .modinfo at vmlinux
# link time. Disabled by default in the kernel; enabled here for the
# GKI build.
CONFIG_MODULE_SKIP_BUILTIN=y
