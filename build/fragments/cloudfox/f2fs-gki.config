# Explicit f2fs compression backend pinning
# Source (CloudFox kernel fs/f2fs/Kconfig):
#   F2FS_FS_LZO/LZ4/LZ4HC/ZSTD/LZORLE are all "default y" behind
#   F2FS_FS_COMPRESSION, so these lines are idempotent today — they pin the
#   backends explicitly so the effective config no longer depends on the
#   Kconfig defaults drifting if F2FS_FS_COMPRESSION is ever toggled.
#   The f2fs zstd path (zstd compress level fix, zstd decompression
#   backports) is required for reliable Zstandard on-disk compression.

CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_LZORLE=y
