# ZRAM compressed RAM block device support
# Source (CloudFox kernel zram Kconfig):
#   https://github.com/CloudFox-INC/CloudFox-Kernel/blob/main/drivers/block/zram/Kconfig
#
# ZRAM depends on BLOCK && SYSFS && ZSMALLOC && CRYPTO; ZRAM_MEMORY_TRACKING
# additionally on DEBUG_FS. Core infra deps (BLOCK/SYSFS/CRYPTO) are skipped
# automatically when already =y, so the fragment is idempotent either way.

# ZRAM core and its Kconfig dependencies
CONFIG_BLOCK=y
CONFIG_SYSFS=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO=y
CONFIG_ZRAM=y

# ZRAM sub-features
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_ZRAM_MULTI_COMP=y

# Dependency of ZRAM_MEMORY_TRACKING
CONFIG_DEBUG_FS=y

# LZ4KD / LZ4KDR compressors for ZRAM
# Source (ACK LTS): crypto/Kconfig CRYPTO_LZ4KD / CRYPTO_LZ4KDR, which register
# the legacy CRYPTO_ALG_TYPE_COMPRESS interface used by zram's zcomp; the lib
# tristates come from lib/Kconfig (LZ4KD_COMPRESS/LZ4KD_DECOMPRESS and
# LZ4KDR_COMPRESS/LZ4KDR_DECOMPRESS). The crypto drivers select CRYPTO_ALGAPI
# and the lib tristates; the lib symbols are listed explicitly for idempotence
# and to force =y rather than depend on select propagation.
CONFIG_LZ4KD_COMPRESS=y
CONFIG_LZ4KD_DECOMPRESS=y
CONFIG_LZ4KDR_COMPRESS=y
CONFIG_LZ4KDR_DECOMPRESS=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_LZ4KDR=y
