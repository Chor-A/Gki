# ZRAM compressed RAM block device support (backports flavor)
# Source (CloudFox kernel backports zram Kconfig):
#   https://github.com/CloudFox-INC/CloudFox-Kernel/blob/android12-5.10-backports/drivers/block/zram/Kconfig
#
# Branch-specific: the backports branch backports the LZ4KD / LZ4KDR zram
# compressors and the ZRAM_DEF_COMP_* default-compressor choice
# (ZRAM_DEF_COMP / ZRAM_DEF_COMP_LZO_RLE / ZRAM_DEF_COMP_LZ4KD /
# ZRAM_DEF_COMP_LZ4KDR). This fragment enables ZRAM with those algorithms and
# selects the speed-tuned LZ4KDR as the default compressor.
#
# ZRAM depends on BLOCK && SYSFS && ZSMALLOC && CRYPTO. Core infra deps are
# skipped automatically when already =y, so the fragment is idempotent.

# ZRAM core and its Kconfig dependencies
CONFIG_BLOCK=y
CONFIG_SYSFS=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO=y
CONFIG_ZRAM=y

# LZ4KD / LZ4KDR compressors for ZRAM
CONFIG_LZ4KD_COMPRESS=y
CONFIG_LZ4KD_DECOMPRESS=y
CONFIG_LZ4KDR_COMPRESS=y
CONFIG_LZ4KDR_DECOMPRESS=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_LZ4KDR=y

# Default compressor choice backported on this branch (selects CRYPTO_LZ4KDR);
# lzo-rle remains the safe fallback when no default is selected.
CONFIG_ZRAM_DEF_COMP_LZ4KDR=y