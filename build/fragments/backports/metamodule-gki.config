# KernelSU metamodule (module-manager) support config
# Sources:
#   Mountify (github.com/backslashxx/mountify): CONFIG_OVERLAY_FS=y required,
#     CONFIG_TMPFS_XATTR=y highly encouraged
#   KernelSU metamodule guide: https://kernelsu.org/guide/metamodule.html
#   ACK LTS android12-5.10 Kconfig tree (symbol/dependency verification)
#
# Everything listed exists in the ACK tree and needs no source modification.
# build-kernel.sh skips symbols already effective in gki_defconfig or another
# fragment, so re-stating the OverlayFS/tmpfs set here is idempotent and makes
# this fragment self-contained.

# Filesystems used by systemless module mounting (OverlayFS over tmpfs)
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Framework/userspace-driven config filesystems used by module tooling
CONFIG_SECURITYFS=y
CONFIG_CONFIGFS_FS=y

# CO-RE eBPF LKM support (e.g. Mountify's nuke_ext4_lkm). Generates vmlinux
# BTF, which requires pahole >= 1.13 in the build toolchain. The 2021-era ACK
# kernel-build-tools bundle predates pahole, so this is NOT enabled here; it
# would fail the build unless the toolchain ships pahole.
# CONFIG_DEBUG_INFO_BTF=y
