--- a/fs/proc/cmdline.c
+++ b/fs/proc/cmdline.c
@@ -3,10 +3,68 @@
 #include <linux/init.h>
 #include <linux/proc_fs.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+static void replace_str(char *buf, size_t max_len, const char *search, const char *replace)
+{
+	char *p = buf;
+	size_t s_len = strlen(search);
+	size_t r_len = strlen(replace);
+
+	while ((p = strstr(p, search)) != NULL) {
+		size_t cur_len = strlen(buf);
+		size_t tail_len = strlen(p + s_len);
+
+		if (r_len > s_len && cur_len + (r_len - s_len) >= max_len)
+			break;
+
+		if (r_len != s_len)
+			memmove(p + r_len, p + s_len, tail_len + 1);
+
+		memcpy(p, replace, r_len);
+		p += r_len;
+	}
+}
 
 static int cmdline_proc_show(struct seq_file *m, void *v)
 {
+	char *buf;
+	size_t len;
+
+	if (!saved_command_line) {
+		seq_putc(m, '\n');
+		return 0;
+	}
+
+	len = strlen(saved_command_line);
+	buf = kzalloc(len + 256, GFP_KERNEL);
+	if (buf) {
+		memcpy(buf, saved_command_line, len + 1);
+		replace_str(buf, len + 256, "androidboot.verifiedbootstate=orange", "androidboot.verifiedbootstate=green");
+		replace_str(buf, len + 256, "androidboot.verifiedbootstate=yellow", "androidboot.verifiedbootstate=green");
+		replace_str(buf, len + 256, "androidboot.verifiedbootstate=red", "androidboot.verifiedbootstate=green");
+		replace_str(buf, len + 256, "androidboot.vbmeta.device_state=unlocked", "androidboot.vbmeta.device_state=locked");
+		replace_str(buf, len + 256, "androidboot.flash.locked=0", "androidboot.flash.locked=1");
+		replace_str(buf, len + 256, "androidboot.selinux=permissive", "androidboot.selinux=enforcing");
+		replace_str(buf, len + 256, "androidboot.buildvariant=userdebug", "androidboot.buildvariant=user");
+		replace_str(buf, len + 256, "androidboot.buildvariant=eng", "androidboot.buildvariant=user");
+		replace_str(buf, len + 256, "buildvariant=userdebug", "buildvariant=user");
+		replace_str(buf, len + 256, "buildvariant=eng", "buildvariant=user");
+		replace_str(buf, len + 256, "androidboot.mode=custom", "androidboot.mode=normal");
+		replace_str(buf, len + 256, "androidboot.mode=recovery", "androidboot.mode=normal");
+		replace_str(buf, len + 256, "androidboot.secureboot=0", "androidboot.secureboot=1");
+		replace_str(buf, len + 256, "androidboot.lockstate=unlocked", "androidboot.lockstate=locked");
+		replace_str(buf, len + 256, "androidboot.warranty_bit=1", "androidboot.warranty_bit=0");
+		replace_str(buf, len + 256, "androidboot.warranty_bits=1", "androidboot.warranty_bits=0");
+		replace_str(buf, len + 256, "androidboot.force_normal_boot=0", "androidboot.force_normal_boot=1");
+		seq_puts(m, buf);
+		kfree(buf);
+		seq_putc(m, '\n');
+		return 0;
+	}
+
 	seq_puts(m, saved_command_line);
 	seq_putc(m, '\n');
 	return 0;
 }
