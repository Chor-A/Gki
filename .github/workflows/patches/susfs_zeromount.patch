+static unsigned long zeromount_get_inode_by_path(const char *path_str)
+{
+	struct path path;
+	struct inode *inode;
+	unsigned long ino = 0;
+
+	if (kern_path(path_str, LOOKUP_FOLLOW, &path) == 0) {
+		inode = d_backing_inode(path.dentry);
+		if (inode)
+			ino = inode->i_ino;
+		path_put(&path);
+	}
+	return ino;
+}
