+static unsigned long zeromount_generate_ino(const char *dir, const char *name)
+{
+	u32 h1 = full_name_hash(NULL, dir, strlen(dir));
+	u32 h2 = full_name_hash(NULL, name, strlen(name));
+
+	return (unsigned long)(h1 ^ h2);
+}
